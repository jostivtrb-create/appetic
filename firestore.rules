rules_version = '2';

// Última actualización: 2026-10-29 (paso 3)
// Cambios paso 3: pedidos de la app → el personal del local (admin, mesero, cocina, domiciliario)
//   los lee y mueve (confirmar, rechazar, en camino, entregado); RESUMEN PÚBLICO
//   (pedidosPublicos) sin teléfono ni dirección, legible solo por su id para «Mi pedido»;
//   rol DOMICILIARIO por local; se retiran los domiciliarios GLOBALES (config/domiciliarios).
// + QR por mesa: el cliente crea su comanda (origen 'qr') directo, si el local activó sus mesas.
// + CAJA: el admin marca cada comanda «cobrada» (porCobrar → false); solo él toca esos campos.
// + DEMO para clientes (esDemo): cualquier sesión (también anónima) la administra, sin tocar
//   WhatsApp/link/horario; el superadmin la reinicia (borra comandas, pedidos y stats).
// Cambios paso 1: EQUIPO por local (meseros y cocina en locales/{id}/equipo, privado) y COMANDAS
//   (locales/{id}/comandas): las leen y escriben solo el admin, los meseros y la cocina ACTIVOS
//   de ese local. El mesero crea; la cocina tacha y entrega. Ver «Guía para Mesero y Comandas».
//   + dispositivos (celulares que reciben el aviso de «pedido listo» con la app cerrada).
// Antes (2026-07-26): rol DOMICILIARIO GLOBAL — retirado en el paso 3.
//
// 🔒 Reglas de Appetic
// - Menú (locales/productos): lectura pública (los clientes ven sin login).
// - Escritura del menú: el admin del local (su correo en local.admins) o el superadmin.
// - Pedidos: cualquiera puede CREAR (el cliente, con o sin login) — el pedido completo es la
//   fuente de verdad del precio y se auto-borra a los 2 días (TTL sobre `ttl`). Lo leen y
//   mueven el personal del local (admin, mesero, cocina, domiciliario) y el superadmin.
//   Su resumen público (pedidosPublicos, sin datos personales) se lee solo por su id.
// - Equipo, comandas y dispositivos: ver cada bloque abajo.
// - Crear/borrar locales: solo desde la consola/seed (nosotros), no desde el cliente.

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdminDe(localId) {
      return request.auth != null
        && request.auth.token.email in get(/databases/$(database)/documents/locales/$(localId)).data.admins;
    }

    // Superadmin (nosotros): controla suscripciones y administra cualquier local. Correo fijo.
    function esSuperadmin() {
      return request.auth != null && request.auth.token.email == 'jostivtrb@gmail.com';
    }

    // 🍔 ¿Es el local de DEMOSTRACIÓN para clientes (Burger Demo, esDemo: true)?
    function esLocalDemo(localId) {
      return get(/databases/$(database)/documents/locales/$(localId)).data.get('esDemo', false) == true;
    }

    // Visitante de la demo: cualquiera con sesión (también la ANÓNIMA, sin correo) administra la
    // demo como si fuera el dueño. Solo ese local. Guía «Demo de clientes» D3/D8.
    function esVisitanteDemo(localId) {
      return request.auth != null && esLocalDemo(localId);
    }

    // ¿Puede administrar ESTE local? El dueño, el superadmin o un visitante de la demo.
    // Va primero la demo: a la sesión anónima le falta el correo y las otras dos darían error.
    // Espejo de puedeAdministrarLocal() en src/config/roles.js: si cambias uno, cambia el otro.
    function puedeAdministrar(localId) {
      return esVisitanteDemo(localId) || esAdminDe(localId) || esSuperadmin();
    }


    // 👥 ¿Es mesero / cocina ACTIVO de ESTE local? Doc locales/{id}/equipo/{rol}:{email}.
    // Espejo de getRolesDeEquipo() en src/services/equipo.js.
    function equipoActivo(localId, rol) {
      return request.auth != null
        && exists(/databases/$(database)/documents/locales/$(localId)/equipo/$(rol + ':' + request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/locales/$(localId)/equipo/$(rol + ':' + request.auth.token.email.lower())).data.activo == true;
    }

    // ¿Trabaja en el salón o la cocina de este local (o lo administra)? → comandas.
    function esPersonal(localId) {
      return puedeAdministrar(localId) || equipoActivo(localId, 'mesero') || equipoActivo(localId, 'cocina');
    }

    // ¿Puede ver y mover los pedidos de la app de este local? El personal + el domiciliario.
    function puedeVerPedidos(localId) {
      return esPersonal(localId) || equipoActivo(localId, 'domiciliario');
    }

    // Perfil de cada cliente: solo el dueño lo lee/escribe.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Config global: la lee cualquier autenticado, solo el superadmin la escribe.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if esSuperadmin();
    }

    match /locales/{localId} {
      allow read: if true;
      // En la demo, el visitante NO toca lo que la rompería para el siguiente (D16): WhatsApp,
      // link, horario, ni las marcas de demo, dueños o suscripción. El superadmin sí (reiniciar).
      allow update: if esSuperadmin()
                    || (puedeAdministrar(localId)
                        && !(esLocalDemo(localId)
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasAny(['whatsapp', 'slug', 'horario', 'esDemo', 'admins', 'suscripcion'])));
      // Los locales se crean desde la consola/seed; la única excepción es la demo, que el
      // superadmin puede volver a crear desde «Reiniciar demo».
      allow create: if esSuperadmin() && request.resource.data.esDemo == true;
      allow delete: if false;

      match /productos/{productoId} {
        allow read: if true;
        allow write: if puedeAdministrar(localId);
      }

      match /pedidos/{pedidoId} {
        // El cliente (con o sin login) CREA su pedido; se exige un total válido y que nazca «nuevo».
        allow create: if request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.estado == 'nuevo';
        // El personal del local lo lee y lo mueve (confirmar, rechazar, en camino, entregado…).
        allow read, update: if puedeVerPedidos(localId);
        allow delete: if esSuperadmin() && esLocalDemo(localId);   // «Reiniciar demo»
      }

      // 🧾 Resumen PÚBLICO del pedido para «Mi pedido» (sin teléfono, dirección ni coordenadas).
      // Se lee SOLO por su id (imposible de adivinar); nadie puede listarlos. Nace junto con su
      // pedido (misma escritura) y lo actualiza el personal del local.
      match /pedidosPublicos/{pedidoId} {
        allow get: if true;
        allow list: if false;
        allow create: if existsAfter(/databases/$(database)/documents/locales/$(localId)/pedidos/$(pedidoId))
                      && request.resource.data.estado == 'nuevo'
                      && !('telefono' in request.resource.data)
                      && !('direccion' in request.resource.data);
        allow update: if puedeVerPedidos(localId);
        allow delete: if esSuperadmin() && esLocalDemo(localId);   // «Reiniciar demo»
      }

      // 👥 Equipo (meseros y cocina). PRIVADO: el documento del local es público y aquí hay
      // correos de personas. Lo maneja el admin; cada persona puede leer SU propio registro.
      match /equipo/{docId} {
        allow read: if puedeAdministrar(localId)
                    || (request.auth != null && resource.data.email == request.auth.token.email.lower());
        allow create, update: if puedeAdministrar(localId)
                              && request.resource.data.rol in ['mesero', 'cocina', 'domiciliario']
                              && request.resource.data.email is string
                              && request.resource.data.localId == localId
                              && docId == request.resource.data.rol + ':' + request.resource.data.email;
        allow delete: if puedeAdministrar(localId);
      }

      // 🧾 Comandas del salón a la cocina. Las lee y mueve el personal del local (admin, meseros,
      // cocina). Solo el admin o un mesero las CREAN, y nacen activas. Nadie las borra desde la app
      // (quedan como historial).
      match /comandas/{comandaId} {
        allow read: if esPersonal(localId);
        // También el CLIENTE desde el QR de su mesa (origen 'qr'), sin sesión: solo si el local
        // activó sus mesas, a una mesa que existe, y nace limpia (sin correcciones ni tachados).
        allow create: if request.resource.data.estado == 'activa'
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0
                      && request.resource.data.items.size() <= 60
                      && (
                        puedeAdministrar(localId) || equipoActivo(localId, 'mesero')
                        || (request.resource.data.origen == 'qr'
                            && request.resource.data.destino.tipo == 'mesa'
                            && get(/databases/$(database)/documents/locales/$(localId)).data.get('mesas', 0) > 0
                            && int(request.resource.data.destino.mesa) >= 1
                            && int(request.resource.data.destino.mesa) <= get(/databases/$(database)/documents/locales/$(localId)).data.get('mesas', 0)
                            && !('cambios' in request.resource.data))
                      );
        // 💵 Lo de COBRO (porCobrar · cobradaEn · cobradaPor) solo lo toca el admin (la caja). Una
        // cancelación del mesero sí la saca de «por cobrar». Guía «Cuenta por mesa» D6.
        allow update: if esPersonal(localId)
                      && request.resource.data.estado in ['activa', 'entregada', 'cancelada']
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['porCobrar', 'cobradaEn', 'cobradaPor'])
                          || puedeAdministrar(localId)
                          || (request.resource.data.estado == 'cancelada' && request.resource.data.get('porCobrar', false) == false
                              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cobradaEn', 'cobradaPor'])));
        allow delete: if esSuperadmin() && esLocalDemo(localId);   // «Reiniciar demo»
      }

      // 🔔 Celulares que reciben el aviso de «pedido listo» (doc id = token de notificaciones).
      // Cada persona del local registra SOLO el suyo (con su correo). Los lee y usa el servidor
      // (/api/notificar-listo, con permisos de administrador), no la app.
      match /dispositivos/{token} {
        allow create, update: if puedeVerPedidos(localId)
                              && request.resource.data.email == request.auth.token.email.lower()
                              && request.resource.data.token == token;
        allow read, delete: if request.auth != null && resource.data.email == request.auth.token.email.lower();
      }

      match /stats/{statId} {
        // Contadores (visitas/pedidos/monto). El cliente los incrementa anónimo;
        // solo el admin del local (o el superadmin) los lee. Escritura acotada a esos campos.
        allow read: if puedeAdministrar(localId);
        allow write: if request.resource.data.keys().hasOnly(['fecha', 'visitas', 'pedidos', 'monto', 'interesados']);
        allow delete: if esSuperadmin() && esLocalDemo(localId);   // «Reiniciar demo»
      }
    }

    // Lectura de pedidos por GRUPO de colecciones (collectionGroup): solo el superadmin
    // (soporte). Los domiciliarios GLOBALES se retiraron: cada local lee los suyos arriba.
    // 👥 Cada persona descubre en qué locales trabaja (consulta de grupo por su correo).
    match /{path=**}/equipo/{docId} {
      allow read: if request.auth != null && resource.data.email == request.auth.token.email.lower();
    }

    match /{path=**}/pedidos/{pedidoId} {
      allow read: if esSuperadmin();
    }
  }
}
