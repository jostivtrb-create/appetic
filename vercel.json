{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/demo",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/demo.js": {
      "maxDuration": 60
    },
    "api/solicitud.js": {
      "maxDuration": 30
    },
    "api/solicitud-archivo.js": {
      "maxDuration": 30
    }
  }
}
