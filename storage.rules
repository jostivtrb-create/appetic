rules_version = '2';

// 🔒 Reglas de Storage de Appetic
// - Lectura pública: las imágenes del menú (logos, fotos de productos y de
//   opciones/toppings) se muestran a todos los clientes sin login.
// - Escritura: solo el admin del local (su correo en locales/{localId}.admins),
//   y únicamente dentro de la carpeta de ese local. Mismo criterio que Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes del local (logos, fotos de productos y de opciones/toppings):
    //   - Lectura pública: el menú las muestra a todos sin login.
    //   - Escritura: cualquier usuario CON SESIÓN. El acceso al panel ya está
    //     restringido al admin del local (firestore.rules), así que en la práctica
    //     solo el admin sube fotos. Evitamos la lectura cruzada a Firestore aquí
    //     porque es frágil y bloqueaba las subidas.
    //   - La sesión ANÓNIMA (visitantes de la demo para clientes) solo sube a la carpeta de la
    //     demo, y solo imágenes de hasta 5 MB. Sin esto, cualquiera podría subir a cualquier local.
    match /locales/{localId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.token.firebase.sign_in_provider != 'anonymous'
                       || (localId == 'demo'
                           && (request.resource == null
                               || (request.resource.size < 5 * 1024 * 1024
                                   && request.resource.contentType.matches('image/.*')))));
    }

    // 📋 Fotos de las solicitudes de cotización de la propuesta web (fachada, carta, logo). Las sube
    // SOLO el servidor (/api/solicitud con firebase-admin, que no pasa por aquí) y las guarda con
    // token de descarga: esas URL con ?token= se abren igual sin pasar por estas reglas. Por el SDK
    // solo las lee el superadmin; desde el cliente nadie escribe.
    // 🧾 Comprobantes de pago con el link del negocio: los sube SOLO el servidor (/api/comprobante) y
    // se abren con la URL con token que queda en el pedido privado. Por el SDK nadie los lee ni lista.
    match /comprobantes/{allPaths=**} {
      allow read, write: if false;
    }

    match /solicitudes/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email == 'jostivtrb@gmail.com';
      allow write: if false;
    }
  }
}
